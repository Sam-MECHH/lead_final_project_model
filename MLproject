name: coherence_medical_checker

# 1. Use Docker Environment
docker_env:
  image: smechh/lead-final-proj-ml-workflow:latest
  # Grant GPU access, shared memory, and local host storage mount
  volumes: ["/home/ubuntu/data:/app/data"]
  run_args: ["--gpus", "all", "--ipc=host", "--net=host"]

entry_points:
  main:
    parameters:
      n_epochs: {type: int, default: 50}
      experiment_name: {type: string, default: "lead_demo_training"}
    
    # 2. The Command
    command: "python src/train.py --n_epochs {n_epochs} --experiment_name {experiment_name}"